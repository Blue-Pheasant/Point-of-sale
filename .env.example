DB_DSN=mysql:host=localhost;port=3306;dbname=point_of_sale
DB_USER=root
DB_PASSWORD=

# Application environment: local | production
APP_ENV=local
# Enable verbose error output. MUST be false in production.
APP_DEBUG=true

# Secret used to sign/verify sandbox payment-gateway callbacks (roadmap T22).
# Generate a random value, e.g. `php -r "echo bin2hex(random_bytes(32));"`.
# NEVER commit a real secret — this example value is a placeholder.
PAYMENT_SANDBOX_SECRET=change-me-to-a-random-secret

# Bearer token required by the JSON REST API (roadmap T23). Sent by clients as
# `Authorization: Bearer <token>`. Generate a random value; placeholder only.
API_TOKEN=change-me-to-a-random-api-token

# Docker Compose credentials (only needed when running `docker-compose up`)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=pos
MYSQL_USER=pos
MYSQL_PASSWORD=
